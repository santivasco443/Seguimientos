@model List<GestorNotas.Models.NotaModel>

@{
    ViewData["Title"] = "Gestor de Notas";
}

<div class="notes-container">
    <div class="notes-header">
        <div class="header-icon">📝</div>
        <h1>Mi Gestor de Notas</h1>
        <p>Guarda tus ideas y organiza tus pensamientos</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="error-message">@TempData["Error"]</div>
    }

    <section class="note-form-card">
        <h2>Crear una nueva nota</h2>

        <form asp-action="Agregar" method="post">
            @Html.AntiForgeryToken()

            <input type="text" name="titulo" maxlength="80"
                   placeholder="Título de la nota" required />

            <textarea name="contenido" maxlength="2000"
                      placeholder="Escribe aquí el contenido de tu nota..."
                      rows="4" required></textarea>

            <button type="submit" class="add-button">Guardar nota</button>
        </form>
    </section>

    <section class="notes-section">
        <div class="notes-section-header">
            <h2>Mis notas</h2>
            <span class="notes-counter">@Model.Count notas</span>
        </div>

        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <span>📂</span>
                <h3>Aún no tienes notas</h3>
                <p>Crea tu primera nota utilizando el formulario.</p>
            </div>
        }
        else
        {
            <div class="notes-grid">
                @foreach (var nota in Model)
                {
                    <article class="note-card">
                        <div class="note-card-header">
                            <h3>@nota.Titulo</h3>

                            <span class="note-date">
                                @nota.FechaModificacion.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>

                        <p class="note-content">@nota.Contenido</p>

                        <div class="note-actions">
                            <button type="button" class="edit-button"
                                    data-id="@nota.Id"
                                    data-title="@nota.Titulo"
                                    data-content="@nota.Contenido">
                                Editar
                            </button>

                            <form asp-action="Eliminar" method="post"
                                  onsubmit="return confirm('¿Seguro que deseas eliminar esta nota?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@nota.Id" />
                                <button type="submit" class="delete-button">
                                    Eliminar
                                </button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <footer class="notes-footer">
        Organiza tus ideas, una nota a la vez.
    </footer>
</div>

<div id="edit-modal" class="modal-overlay">
    <div class="modal-card">
        <h2>Editar nota</h2>

        <form asp-action="Editar" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" id="edit-id" />

            <input type="text" name="titulo" id="edit-title"
                   maxlength="80" placeholder="Título" required />

            <textarea name="contenido" id="edit-content"
                      maxlength="2000" rows="6"
                      placeholder="Contenido" required></textarea>

            <div class="modal-actions">
                <button type="button" id="cancel-edit" class="cancel-button">
                    Cancelar
                </button>
                <button type="submit" class="save-button">
                    Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/notas.js" asp-append-version="true"></script>
}
