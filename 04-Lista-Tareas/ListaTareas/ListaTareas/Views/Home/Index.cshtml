@model List<ListaTareas.Models.TareaModel>

@{
    ViewData["Title"] = "Lista de Tareas";
    string filtroActual = ViewBag.Filtro ?? "todas";
    int total = Model.Count;
    int completadas = Model.Count(t => t.Completada);
    int pendientes = total - completadas;
}

<div class="todo-container">
    <div class="todo-card">
        <header class="todo-header">
            <div class="header-icon">✓</div>
            <h1>Mi Lista de Tareas</h1>
            <p>Organiza tus actividades y alcanza tus objetivos</p>
        </header>

        <section class="statistics">
            <div class="stat-box">
                <span class="stat-number">@total</span>
                <span class="stat-label">Total</span>
            </div>
            <div class="stat-box">
                <span class="stat-number">@pendientes</span>
                <span class="stat-label">Pendientes</span>
            </div>
            <div class="stat-box">
                <span class="stat-number">@completadas</span>
                <span class="stat-label">Completadas</span>
            </div>
        </section>

        <form asp-action="Agregar" method="post" class="add-form">
            @Html.AntiForgeryToken()
            <input type="text" name="descripcion" maxlength="100"
                   placeholder="¿Qué necesitas hacer?" required />
            <button type="submit">Agregar tarea</button>
        </form>

        <nav class="filters">
            <a asp-action="Index" asp-route-filtro="todas"
               class="@(filtroActual == "todas" ? "active" : "")">Todas</a>
            <a asp-action="Index" asp-route-filtro="pendientes"
               class="@(filtroActual == "pendientes" ? "active" : "")">Pendientes</a>
            <a asp-action="Index" asp-route-filtro="completadas"
               class="@(filtroActual == "completadas" ? "active" : "")">Completadas</a>
        </nav>

        <section class="task-list">
            @if (Model.Count == 0)
            {
                <div class="empty-state">
                    <span>📋</span>
                    <h3>No hay tareas para mostrar</h3>
                    <p>Agrega una tarea para comenzar a organizarte.</p>
                </div>
            }
            else
            {
                @foreach (var tarea in Model)
                {
                    <article class="task-item @(tarea.Completada ? "completed" : "")">
                        <form asp-action="Completar" method="post" class="complete-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@tarea.Id" />
                            <button type="submit" class="check-button"
                                    aria-label="Cambiar estado de la tarea">
                                @(tarea.Completada ? "✓" : "")
                            </button>
                        </form>

                        <div class="task-content">
                            <span class="task-description">@tarea.Descripcion</span>
                            <small>@tarea.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>

                        <div class="task-actions">
                            <button type="button" class="edit-button"
                                    data-id="@tarea.Id"
                                    data-description="@tarea.Descripcion">
                                Editar
                            </button>

                            <form asp-action="Eliminar" method="post"
                                  onsubmit="return confirm('¿Seguro que deseas eliminar esta tarea?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@tarea.Id" />
                                <button type="submit" class="delete-button">Eliminar</button>
                            </form>
                        </div>
                    </article>
                }
            }
        </section>

        <footer class="todo-footer">
            <span>Organiza tu día, una tarea a la vez.</span>
        </footer>
    </div>
</div>

<div id="edit-modal" class="modal-overlay">
    <div class="modal-card">
        <h2>Editar tarea</h2>

        <form asp-action="Editar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="edit-id" />
            <input type="text" name="descripcion" id="edit-description"
                   maxlength="100" required />
            <div class="modal-actions">
                <button type="button" id="cancel-edit" class="cancel-button">
                    Cancelar
                </button>
                <button type="submit" class="save-button">Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/tareas.js" asp-append-version="true"></script>
}